DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 个人 API Key 的数据库加密密钥；缺省时默认聊天可用，个人 Key 保存不可用。
# 生成后填入下行并保留备份，不要提交真实密钥或随意替换：
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MODEL_SETTINGS_ENCRYPTION_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ZHIPUAI_API_KEY=
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
MAX_UPLOAD_BYTES=5MB

# LangSmith 可观测性（可选）。创建 LangSmith API Key 后，将 TRACING 改为 true。
# 启用后，模型输入/输出、工具参数/结果、耗时和错误会上传到 LangSmith 项目；
# 不要在含真实敏感数据的环境中未经评估直接开启。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-bot
# 默认使用 LangSmith 托管服务；私有部署或指定区域时再修改。
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# API Key 若同时属于多个 workspace，按 LangSmith 控制台信息填写；否则留空。
LANGSMITH_WORKSPACE_ID=

# Docker Compose 使用这些值创建 PostgreSQL，并自动生成容器内 DATABASE_URL。
POSTGRES_DB=ai_bot
POSTGRES_USER=ai_bot
POSTGRES_PASSWORD=ai_bot_password
